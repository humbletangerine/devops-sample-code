{
  "id": null,
  "uid": "quick-commerce-q9",
  "title": "Quick-Commerce API Operations",
  "tags": ["quick-commerce", "kubernetes", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Healthy API Pods", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(up{job=\"product-api-pods\"})", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 3}]}}, "overrides": []}},
    {"id": 2, "type": "timeseries", "title": "API Requests / second", "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(rate(product_api_requests_total{job=\"product-api-pods\"}[1m]))", "legendFormat": "requests/sec", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}},
    {"id": 3, "type": "timeseries", "title": "Container CPU by Pod (millicores)", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"quick-commerce\",pod=~\"product-api-.*\",container!=\"\",container!=\"POD\"}[2m])) * 1000", "legendFormat": "{{pod}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "mcores"}, "overrides": []}},
    {"id": 4, "type": "timeseries", "title": "Container Memory by Pod", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "container_memory_working_set_bytes{namespace=\"quick-commerce\",pod=~\"product-api-.*\",container!=\"\",container!=\"POD\"}", "legendFormat": "{{pod}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}},
    {"id": 5, "type": "timeseries", "title": "Flask Worker CPU (%)", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "app_process_cpu_percent{job=\"product-api-pods\"}", "legendFormat": "{{pod}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []}},
    {"id": 6, "type": "timeseries", "title": "Flask Worker Resident Memory", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "app_process_memory_bytes{job=\"product-api-pods\"}", "legendFormat": "{{pod}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}},
    {"id": 7, "type": "timeseries", "title": "Availability Request p95 Latency", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(product_api_request_duration_seconds_bucket{job=\"product-api-pods\"}[5m])))", "legendFormat": "p95", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}}
  ]
}
